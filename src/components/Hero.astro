---
import DownloadButtons from "./DownloadButtons.astro";
import { REPO_URL } from "../lib/repo";
---

<section class="hero-section" id="hero">
  <!-- Subtle background blobs -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
  </div>

  <div class="hero-container" role="group">
    <!-- Left column -->
    <div class="hero-left">
      <h1 class="hero-headline">
        Klarheit über dein Geld.<br />Bleibt bei dir&nbsp;–&nbsp;sonst nirgends.
      </h1>

      <p class="hero-subhead">
        Mehrere Konten, ein Depot, eine Excel-Tabelle, die nie aktuell ist –
        und trotzdem kein wirklicher Überblick. Klarwert bringt deine Finanzen
        zusammen, ohne dass du sie einem Unternehmen anvertraust.
      </p>

      <!-- Rotating example: typewriter delete/retype effect -->
      <p class="carousel-label">Klarwert erkennt automatisch:</p>
      <div class="carousel" aria-hidden="true">
        <span id="tw-text" class="mono"></span><span class="caret"></span>
        <span class="arrow">→</span>
        <span id="tw-badge" class="badge"></span>
      </div>

      <!-- CTAs -->
      <div class="hero-ctas" id="download">
        <DownloadButtons />
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-ghost"
        >
          Quellcode ansehen
        </a>
      </div>

      <p class="hero-trust-line">
        Kostenlos für immer. Kein Konto, keine Cloud, kein Abo.
      </p>
    </div>

    <!-- Right column: Mockup -->
    <div class="hero-right">

      <!-- Notebook mockup -->
      <div class="notebook-wrap">
        <div class="notebook-frame">
          <div class="notebook-screen">
            <img
              src="/klarwert-dashboard-dummy.svg"
              alt="Klarwert Dashboard – Übersicht mit Sankey-Diagramm, Kategorien und Budgets"
              class="notebook-img"
              loading="eager"
            />
            <!-- Platzhalter, ersetzen sobald echte Screenshots vorliegen -->
          </div>
          <div class="notebook-chin"></div>
        </div>

        <!-- Floating cards -->
        <div class="float-card animate-float-1 card-budget">
          <p class="card-label">Budget Lebensmittel</p>
          <p class="card-value card-value--charcoal">312&nbsp;€ / 400&nbsp;€</p>
          <div class="card-bar">
            <div class="card-bar-fill" style="width:78%"></div>
          </div>
        </div>

        <div class="float-card animate-float-2 card-konto">
          <p class="card-label">Kontostand gesamt</p>
          <p class="card-value card-value--petrol">24.180&nbsp;€</p>
          <p class="card-delta">+2,4&nbsp;%</p>
        </div>

        <div class="float-card animate-float-3 card-ausgaben">
          <div>
            <p class="card-label">Ausgaben August</p>
            <p class="card-value card-value--brick">2.180&nbsp;€</p>
          </div>
          <!-- Mini donut -->
          <svg class="mini-donut" viewBox="0 0 36 36" aria-hidden="true">
            <circle cx="18" cy="18" r="14" fill="none" stroke="var(--slate)" stroke-width="4" stroke-dasharray="36 52"/>
            <circle cx="18" cy="18" r="14" fill="none" stroke="var(--gold)"  stroke-width="4" stroke-dasharray="20 68" stroke-dashoffset="-36"/>
            <circle cx="18" cy="18" r="14" fill="none" stroke="var(--sage)"  stroke-width="4" stroke-dasharray="16 72" stroke-dashoffset="-56"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section ── */
  .hero-section {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 6rem 1.5rem 3rem;
    background: var(--paper);
    overflow: visible; /* allow full-bleed blobs to extend to viewport edges */
  }

  /* ── Background blobs (full-bleed) ── */
  .hero-bg {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 100vw; /* span the entire viewport */
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: visible;
  }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
  }

  .hero-blob-1 {
    top: -25%;
    right: 10%;
    width: 160%;
    height: 160%;
    background: radial-gradient(circle at 70% 30%, rgba(18,49,56,0.12) 0%, rgba(18,49,56,0.08) 30%, rgba(18,49,56,0.03) 60%, rgba(18,49,56,0.00) 100%);
    filter: blur(120px);
  }

  .hero-blob-2 {
    bottom: -25%;
    left: 10%;
    width: 160%;
    height: 160%;
    background: radial-gradient(circle at 30% 70%, rgba(183,154,91,0.10) 0%, rgba(183,154,91,0.06) 30%, rgba(183,154,91,0.02) 60%, rgba(183,154,91,0.00) 100%);
    filter: blur(120px);
  }

  /* ── Container grid ── */
  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  /* ── Left column ── */
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 3.25rem);
    color: var(--charcoal);
    line-height: 1.2;
  }

  .hero-subhead {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--slate);
    line-height: 1.65;
    max-width: 44ch;
  }

  /* ── Rotating example (typewriter) ── */
  .carousel-label {
    font-size: 11px;
    color: var(--slate);
    margin-top: 0.2rem;
  }

  .carousel {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    min-height: 28px;
    margin-top: 0.25rem;
    font-size: 14px;
  }

  .carousel #tw-text {
    font-family: var(--font-mono);
    color: var(--charcoal);
    white-space: nowrap;
  }

  .caret {
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 1px;
    background: var(--charcoal);
    vertical-align: text-bottom;
    animation: caret-blink 1s steps(1) infinite;
  }

  @keyframes caret-blink {
    0%, 49%  { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .carousel .arrow {
    color: var(--slate);
  }

  .carousel .badge {
    border-radius: 4px;
    padding: 0.125rem 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .badge-gold { background: rgba(183, 154, 91, 0.18); color: var(--gold); }
  .badge-slate { background: rgba(107, 122, 128, 0.18); color: var(--slate); }
  .badge-petrol-light { background: rgba(29, 71, 80, 0.18); color: var(--petrol-light); }
  .badge-sage { background: rgba(111, 154, 109, 0.18); color: var(--sage); }
  .badge-brick { background: rgba(182, 80, 58, 0.18); color: var(--brick); }

  @media (prefers-reduced-motion: reduce) {
    .caret { animation: none; opacity: 1; }
    .carousel .badge { transition: none; }
  }

  /* ── CTAs ── */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .cta-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border: 1.5px solid var(--petrol);
    border-radius: var(--radius-lg);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--petrol);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
  }
  .cta-ghost:hover {
    background: var(--petrol);
    color: var(--paper);
    text-decoration: none;
  }

  .hero-trust-line {
    font-size: 0.8125rem;
    color: var(--slate);
    font-weight: 500;
  }

  /* ── Right column ── */
  .hero-right {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
  }


  /* ── Notebook ── */
  .notebook-wrap {
    position: relative;
    width: 100%;
    max-width: 560px;
    z-index: 1;
  }

  .notebook-frame {
    border-radius: 14px;
    border: 8px solid #2a2623;
    background: #2a2623;
    box-shadow:
      0 30px 80px rgba(18, 49, 56, 0.25),
      0 0 0 1px rgba(18, 49, 56, 0.1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .notebook-screen {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--paper);
  }

  .notebook-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .notebook-chin {
    height: 14px;
    background: rgba(255,255,255,0.06);
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  /* ── Floating cards ── */
  .float-card {
    position: absolute;
    background: rgba(255, 253, 248, 0.80);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(18, 49, 56, 0.10);
    border-radius: 14px;
    box-shadow: 0 10px 40px rgba(18, 49, 56, 0.12);
    padding: 0.875rem 1rem;
    display: none; /* hidden on mobile */
  }

  @media (min-width: 768px) {
    .float-card { display: block; }
    .card-ausgaben { display: flex; gap: 0.75rem; align-items: center; }
  }

  .card-budget  { top: 6%;  left: -10%; width: 200px; z-index: 3; }
  .card-konto   { top: 42%; right: -8%; width: 180px; z-index: 3; }
  .card-ausgaben { bottom: 8%; left: 6%; width: 215px; z-index: 3; }

  .card-label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--slate);
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .card-value {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 500;
    margin-bottom: 0.35rem;
  }
  .card-value--charcoal { color: var(--charcoal); }
  .card-value--petrol   { color: var(--petrol); }
  .card-value--brick    { color: var(--brick); }

  .card-delta {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sage);
  }

  .card-bar {
    height: 5px;
    border-radius: 99px;
    background: rgba(107,122,128,0.15);
    overflow: hidden;
  }
  .card-bar-fill {
    height: 100%;
    background: var(--sage);
    border-radius: 99px;
  }

  .mini-donut {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    transform: rotate(-90deg);
  }
</style>

<script>
  // Typewriter effect over a fixed list of well-known example transactions: types the
  // merchant/amount text out character by character, shows the category badge, holds,
  // then deletes it character by character before moving to the next example.
  const TYPEWRITER_EXAMPLES = [
    { text: "Rewe Sagt Danke · 42,17 €", badge: "Lebensmittel", badgeClass: "badge-gold" },
    { text: "Miete · 1.200,00 €", badge: "Wohnen", badgeClass: "badge-slate" },
    { text: "Netflix · 12,99 €", badge: "Freizeit", badgeClass: "badge-petrol-light" },
    { text: "Sparplan Depot · 250,00 €", badge: "Sparen", badgeClass: "badge-sage" },
    { text: "Deutsche Bahn · 89,90 €", badge: "Mobilität", badgeClass: "badge-brick" },
    { text: "Amazon · 34,50 €", badge: "Shopping", badgeClass: "badge-gold" },
    { text: "Stadtwerke · 96,40 €", badge: "Wohnen", badgeClass: "badge-slate" },
    { text: "Spotify · 9,99 €", badge: "Freizeit", badgeClass: "badge-petrol-light" },
  ];

  const TYPE_MS = 45;
  const DELETE_MS = 25;
  const PAUSE_MS = 1600;
  const GAP_MS = 300;

  function startTypewriter() {
    const textEl = document.getElementById("tw-text");
    const badgeEl = document.getElementById("tw-badge");
    if (!textEl || !badgeEl) return;

    let timer: ReturnType<typeof setTimeout>;

    function showInstant(index: number) {
      const ex = TYPEWRITER_EXAMPLES[index];
      textEl!.textContent = ex.text;
      badgeEl!.textContent = ex.badge;
      badgeEl!.className = "badge " + ex.badgeClass;
      badgeEl!.style.opacity = "1";
    }

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let i = 0;
      showInstant(i);
      setInterval(() => {
        i = (i + 1) % TYPEWRITER_EXAMPLES.length;
        showInstant(i);
      }, 3000);
      return;
    }

    let index = 0;

    function typeText(text: string, done: () => void) {
      let pos = 0;
      (function step() {
        textEl!.textContent = text.slice(0, pos);
        pos++;
        if (pos <= text.length) {
          timer = setTimeout(step, TYPE_MS);
        } else {
          done();
        }
      })();
    }

    function deleteText(text: string, done: () => void) {
      let pos = text.length;
      (function step() {
        textEl!.textContent = text.slice(0, pos);
        pos--;
        if (pos >= 0) {
          timer = setTimeout(step, DELETE_MS);
        } else {
          done();
        }
      })();
    }

    function cycle() {
      const ex = TYPEWRITER_EXAMPLES[index];
      badgeEl!.style.opacity = "0";
      typeText(ex.text, () => {
        badgeEl!.textContent = ex.badge;
        badgeEl!.className = "badge " + ex.badgeClass;
        badgeEl!.style.opacity = "1";
        timer = setTimeout(() => {
          badgeEl!.style.opacity = "0";
          deleteText(ex.text, () => {
            index = (index + 1) % TYPEWRITER_EXAMPLES.length;
            timer = setTimeout(cycle, GAP_MS);
          });
        }, PAUSE_MS);
      });
    }

    cycle();
  }

  try {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", startTypewriter);
    } else {
      startTypewriter();
    }
  } catch (e) {
    console.error("typewriter failed", e);
  }
</script>
