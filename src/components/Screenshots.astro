---
const markers = [
  { n: 1, top: "51%", left: "43%", label: "Geldfluss", text: "„Wo ist dein Geld diesen Monat hingeflossen?“" },
  { n: 2, top: "51%", left: "71%", label: "Kategorien", text: "„Lebensmittel, Wohnen, Mobilität – automatisch erkannt.“" },
  { n: 3, top: "16%", left: "74%", label: "Budgets", text: "„Nicht erst am Monatsende merken, dass du drüber bist.“" },
  { n: 4, top: "16%", left: "21%", label: "Kontostand", text: "„Konten und Depot gemeinsam im Blick.“" },
];
---

<section class="screenshots-section reveal">
  <div class="section-inner">
    <h2>So sieht Klarwert aus</h2>
    <p class="screenshots-sub">Eine Übersicht auf einen Blick.</p>

    <div class="mockup-wrap">
      <div class="mockup-frame">
        <div class="mockup-screen annotated">
          <img
            src="/klarwert-dashboard-dummy.svg"
            alt="Klarwert Übersichts-Dashboard mit Sankey-Geldfluss, Kategorien-Donut und KPI-Karten"
            loading="lazy"
          />
          <!-- Platzhalter, ersetzen sobald echte Screenshots vorliegen -->

          {markers.map((m) => (
            <details class="marker" style={`top:${m.top}; left:${m.left};`}>
              <summary aria-label={`Erklärung: ${m.label}`}>{m.n}</summary>
              <div class="marker-tooltip">
                <strong>{m.label}</strong>
                <p>{m.text}</p>
              </div>
            </details>
          ))}
        </div>
        <div class="mockup-chin"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .screenshots-section {
    padding: 5rem 1.5rem;
    background: var(--paper);
  }

  .section-inner {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  .section-inner h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--petrol);
    margin-bottom: 0.5rem;
  }

  .screenshots-sub {
    font-size: 1rem;
    color: var(--slate);
    margin-bottom: 2.5rem;
  }

  .mockup-wrap {
    display: flex;
    justify-content: center;
  }

  .mockup-frame {
    width: 100%;
    max-width: 860px;
    border-radius: 14px;
    border: 8px solid #2a2623;
    background: #2a2623;
    box-shadow:
      0 40px 100px rgba(18, 49, 56, 0.22),
      0 0 0 1px rgba(18, 49, 56, 0.08);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .mockup-screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--paper);
  }

  .mockup-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .mockup-chin {
    height: 14px;
    background: rgba(255,255,255,0.06);
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  /* ── Annotation markers ── */
  .marker {
    position: absolute;
    transform: translate(-50%, -50%);
  }

  .marker summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--petrol);
    color: var(--paper);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    box-shadow: 0 0 0 4px rgba(255, 253, 248, 0.55), 0 4px 12px rgba(18, 49, 56, 0.35);
  }

  .marker summary::-webkit-details-marker {
    display: none;
  }

  .marker summary:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .marker-tooltip {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 220px;
    background: var(--card);
    border: 1px solid rgba(18, 49, 56, 0.12);
    border-radius: var(--radius-sm);
    box-shadow: 0 8px 24px rgba(18, 49, 56, 0.18);
    padding: 0.6rem 0.75rem;
    text-align: left;
    z-index: 5;
  }

  .marker-tooltip strong {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--petrol);
    margin-bottom: 0.15rem;
  }

  .marker-tooltip p {
    font-size: 0.75rem;
    color: var(--slate);
    line-height: 1.45;
  }

  @media (max-width: 640px) {
    .marker summary { width: 22px; height: 22px; font-size: 0.7rem; }
    .marker-tooltip { max-width: 160px; }
  }
</style>
