---
const groups = [
  {
    title: "Verstehen",
    subtitle: "Wo geht dein Geld hin?",
    items: [
      {
        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>`,
        title: "Import & Kategorisierung",
        text: "CSV oder Excel rein, Ordnung raus. Klarwert erkennt Händler und Kategorien automatisch – lernt dabei aus deinen eigenen Korrekturen."
      },
      {
        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>`,
        title: "Verträge & Wiederkehrendes",
        text: "Alle Abos und Daueraufträge an einem Ort. Klarwert erkennt wiederkehrende Zahlungen automatisch aus deinen Buchungen."
      },
    ],
  },
  {
    title: "Planen",
    subtitle: "Was willst du mit deinem Geld?",
    items: [
      {
        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.5 1.5-1 2-2h2v-4h-2c0-1-.5-1.5-1-2h0V5z"/><path d="M2 9v1c0 1.1.9 2 2 2h1"/></svg>`,
        title: "Sparen nach Zweck",
        text: "Ob Rücklage, Urlaub oder Depot – jedes Sparziel sichtbar, mit echtem Fortschritt statt vager Vorsätze."
      },
      {
        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>`,
        title: "Budgets",
        text: "Grenzen setzen, die du auch einhältst – weil du sie siehst, bevor der Monat vorbei ist."
      },
    ],
  },
  {
    title: "Vorausdenken",
    subtitle: "Was bedeutet das für deine Zukunft?",
    items: [
      {
        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16.01" y1="10" y2="10"/><line x1="12" x2="12.01" y1="10" y2="10"/><line x1="8" x2="8.01" y1="10" y2="10"/><line x1="16" x2="16.01" y1="14" y2="14"/><line x1="12" x2="12.01" y1="14" y2="14"/><line x1="8" x2="8.01" y1="14" y2="14"/></svg>`,
        title: "Finanz-Rechner",
        text: "FIRE, Zinseszins, Entnahmeplan – rechne durch, was dein Geld in 10, 20, 30 Jahren für dich tun kann."
      },
    ],
  },
];
---

<section id="features" class="features-section reveal">
  <div class="section-inner">
    <div class="section-header">
      <h2>Was Klarwert kann</h2>
      <p>Alles, was du brauchst, um deine Finanzen im Griff zu behalten.</p>
    </div>

    <div class="feature-groups">
      {groups.map((group) => (
        <div class="feature-group">
          <div class="group-header">
            <h3>{group.title}</h3>
            <p>{group.subtitle}</p>
          </div>
          <div class="feature-group-grid">
            {group.items.map((f) => (
              <article class="feature-card glass-card">
                <div class="feature-icon" set:html={f.icon} />
                <h4>{f.title}</h4>
                <p>{f.text}</p>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="scenario glass-card">
      <h3>Wenn im März die Steuererklärung ansteht</h3>
      <p>
        Klarwert hat deine relevanten Buchungen bereits kategorisiert und
        zugeordnet. Ausgaben → Kategorien → steuerrelevante Positionen →
        Unterlagen für den Steuerberater. Vorsichtig formuliert: Klarwert
        bereitet vor, es ersetzt keine Steuerberatung.
      </p>
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 5rem 1.5rem;
    background: var(--paper);
  }

  .section-inner {
    max-width: 1140px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--petrol);
    margin-bottom: 0.75rem;
  }

  .section-header p {
    font-size: 1rem;
    color: var(--slate);
    max-width: 44ch;
    margin: 0 auto;
  }

  .feature-groups {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .group-header {
    margin-bottom: 1.25rem;
  }

  .group-header h3 {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    color: var(--petrol);
  }

  .group-header p {
    font-size: 0.9rem;
    color: var(--slate);
    margin-top: 0.2rem;
  }

  .feature-group-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 600px) {
    .feature-group-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .feature-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .feature-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 48px rgba(18, 49, 56, 0.12);
  }

  .feature-icon {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--petrol);
    background: rgba(18, 49, 56, 0.07);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
  }

  .feature-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .feature-card h4 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--charcoal);
  }

  .feature-card p {
    font-size: 0.9rem;
    color: var(--slate);
    line-height: 1.6;
  }

  .scenario {
    margin-top: 3rem;
    padding: 1.75rem 2rem;
  }

  .scenario h3 {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--petrol);
    margin-bottom: 0.6rem;
  }

  .scenario p {
    font-size: 0.9rem;
    color: var(--slate);
    line-height: 1.65;
    max-width: 62ch;
  }
</style>
