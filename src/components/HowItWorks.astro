---
const steps = [
  {
    num: "1",
    title: "CSV oder Excel exportieren",
    text: "Aus deinem Online-Banking, in ein paar Klicks. Klarwert liest die gängigen deutschen Bankformate.",
  },
  {
    num: "2",
    title: "Automatisch einordnen lassen",
    text: "Klarwert erkennt Händler, Kategorien und wiederkehrende Zahlungen – lokal, ohne dass irgendwas dein Gerät verlässt.",
  },
  {
    num: "3",
    title: "Alles auf einen Blick sehen",
    text: "Konten, Budgets, Sparziele und Steuer-Unterlagen – ein Überblick statt zehn Excel-Tabellen.",
  },
];
---

<section id="workflow" class="workflow-section reveal">
  <div class="section-inner">
    <div class="section-header">
      <h2>So funktioniert's</h2>
      <p>In drei Schritten zum vollen Überblick.</p>
    </div>

    <!-- Data flow connector (desktop) -->
    <div class="flow-connector" aria-hidden="true">
      <svg class="flow-line" viewBox="0 0 900 40" preserveAspectRatio="none">
        <line x1="150" y1="20" x2="750" y2="20" stroke="var(--gold)" stroke-width="1.5"
          stroke-dasharray="6 8" opacity="0.45"/>
      </svg>
    </div>

    <div class="steps-grid">
      {steps.map((s) => (
        <div class="step-card glass-card">
          <div class="step-num">{s.num}</div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .workflow-section {
    padding: 5rem 1.5rem;
    background: rgba(243,239,228,0.5);
  }

  .section-inner {
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--petrol);
    margin-bottom: 0.75rem;
  }

  .section-header p {
    font-size: 1rem;
    color: var(--slate);
  }

  /* The SVG connector sits between header and grid */
  .flow-connector {
    display: none;
    position: relative;
    height: 40px;
    margin-bottom: -20px; /* overlap with steps */
    pointer-events: none;
    z-index: 0;
  }
  .flow-line {
    width: 100%;
    height: 40px;
    display: block;
  }

  @media (min-width: 768px) {
    .flow-connector { display: block; }
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .steps-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .step-card {
    padding: 2rem 1.5rem;
    text-align: center;
    transition: transform 0.25s ease;
  }

  .step-card:hover {
    transform: translateY(-3px);
  }

  .step-num {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--petrol);
    color: var(--petrol);
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
  }

  .step-card h3 {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--charcoal);
    margin-bottom: 0.5rem;
  }

  .step-card p {
    font-size: 0.875rem;
    color: var(--slate);
    line-height: 1.6;
  }
</style>
