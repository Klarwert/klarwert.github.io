---
import Layout from "../layouts/Layout.astro";

const target = "/download#macos";
---

<Layout title="Klarwert für macOS" description="Klarwert für macOS herunterladen und installieren.">
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
  </Fragment>

  <section class="mx-auto max-w-[880px] px-6 py-20 text-center">
    <p class="text-sm text-slate">
      Weiterleitung zu <a href={target} class="underline text-petrol">/download#macos</a> …
    </p>
    <noscript>
      <p class="mt-2 text-sm">
        Falls die Weiterleitung nicht automatisch startet: <a href={target} class="underline text-petrol">hier klicken</a>.
      </p>
    </noscript>
  </section>
</Layout>
